{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/extension/.wxt/wxt.d.ts", "apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"],
  "exclude": ["**/.wxt", "**/.output", "**/node_modules"]
}
